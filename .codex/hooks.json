{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/kaimon-session-start.sh\"",
        "timeout": 5
      }]
    }],
    "PreToolUse": [{
      "matcher": "^Bash$",
      "hooks": [{
        "type": "command",
        "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/prefer-kaimon-search.sh\"",
        "timeout": 5
      }]
    }]
  }
}
